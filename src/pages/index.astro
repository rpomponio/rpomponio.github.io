---
import '../styles/global.css';
const directions = [
  {
    href: "/science/",
    label: "Science",
    text: "My professional work as a biomedical statistician, spanning public health, neuroimaging, and translational research."
  },
  {
    href: "/adventures/",
    label: "Adventure",
    text: "My trip reports from rock climbing and mountaineering exploits in North America, including the Colorado Rockies, Grand Tetons, and North Cascades of the Pacific Northwest."
  },
  {
    href: "/creative/",
    label: "Creativity",
    text: "Experiments in analog and digital photography."
  }
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>pompon.io | ray's website</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="home">
    <main>
      <header class="intro reveal">
        <p class="eyebrow">Pompon.io</p>
        <h1>Work, play, and<br />creative projects.</h1>
        <p class="lede">
          A personal archive spanning biomedical statistics, adventure climbing, photography, and whatever comes next.
        </p>
      </header>

      <nav class="directions" aria-label="Primary">
        {directions.map((item) => (
          <a class="direction reveal" href={item.href}>
            <span class="direction-label">{item.label}</span>
            <span class="direction-text">{item.text}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
    </main>
    <script>
      const observer = new IntersectionObserver(
        entries => entries.forEach(entry => {
          if (entry.isIntersecting) entry.target.classList.add('visible');
        }),
        { threshold: 0.08 }
      );
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
