---
import '../../styles.css';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('science');

  return projects.map((project) => ({
    params: {
      slug: project.id.replace(/\.md$/, ''),
    },
    props: {
      project,
    },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{project.data.title} — Raymond Pomponio</title>
    <meta
      name="description"
      content={project.data.description}
    />
    <link rel="stylesheet" href="/styles.css" />
  </head>

  <body class="science">
    <main class="section-shell">
      <a class="back" href="/science/">← Scientific Contributions</a>

      <header class="section-header">
        <p class="eyebrow">01 / Science</p>
        <h1>{project.data.title}</h1>
        <p>{project.data.description}</p>
      </header>

      <article class="project-content">
        <Content />
      </article>
    </main>
  </body>
</html>